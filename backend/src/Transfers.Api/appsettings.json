{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Transfers": "Host=localhost;Port=5432;Database=transfers;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "TransferPeriods": {
    "TimeZoneId": "America/Sao_Paulo",
    "DayStartsAt": "06:00",
    "NightStartsAt": "22:00"
  },
  "DefaultTransferLimits": {
    "Daytime": {
      "MaxAmountPerHour": 5000,
      "MaxAttemptsPerHour": 5
    },
    "Nighttime": {
      "MaxAmountPerHour": 1000,
      "MaxAttemptsPerHour": 3
    }
  },
  "ScheduledTransfers": {
    "Enabled": true,
    "PollingInterval": "00:00:05",
    "BatchSize": 50
  }
}
